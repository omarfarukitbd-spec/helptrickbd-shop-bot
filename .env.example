# KeyCraft token-reseller bot — configuration
# Copy this file to ".env" and fill in YOUR OWN values.
# NEVER commit the real .env file to GitHub.

# --- Telegram bot (from @BotFather: /newbot) ---
TELEGRAM_BOT_TOKEN=123456789:PASTE_YOUR_BOTFATHER_TOKEN_HERE

# --- KeyCraft Reseller API (from @KeyCraftShopBot / enterpriceai.store) ---
KEYCRAFT_API_KEY=PASTE_YOUR_KEYCRAFT_API_KEY_HERE
# Base URL normally stays as-is:
KEYCRAFT_BASE_URL=https://enterpriceai.store/api/v1

# --- Admin: YOUR Telegram user ID (get it from @userinfobot) ---
ADMIN_TELEGRAM_ID=123456789

# --- Payment details shown to customers ---
# Bangladesh customers pay to these numbers (Send Money).
BKASH_NUMBER=01XXXXXXXXX
NAGAD_NUMBER=01XXXXXXXXX
# Global customers pay USDT to this Binance Pay ID (no spaces).
BINANCE_PAY_ID=123456789

# --- Package prices (change anytime, no code change needed) ---
# Bangladesh prices in BDT:
PRICE_1B=30
PRICE_5B=150
PRICE_10B=300
# Global prices in USDT (Binance Pay):
PRICE_1B_USDT=1
PRICE_5B_USDT=4
PRICE_10B_USDT=7

# --- Optional tuning ---
# DB_PATH=orders.db
# POLL_INTERVAL_SEC=15
# POLL_MAX_ATTEMPTS=120
